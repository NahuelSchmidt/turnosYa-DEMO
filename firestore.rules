rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isRealUser() {
      return isSignedIn() && !isAnonymous();
    }

    function isGlobalAdmin() {
      return isRealUser() && exists(/databases/$(database)/documents/globalAdmins/$(request.auth.uid));
    }

    function isSalonAdmin(salonId) {
      return isRealUser() && (
        get(/databases/$(database)/documents/salons/$(salonId)).data.adminMembers[request.auth.uid] == true
      );
    }

    // El negocio cobra seña: la activó y puede cobrarla (Mercado Pago conectado,
    // o alias cargado si la cobra por transferencia)
    function depositRequired(salonId) {
      let salon = get(/databases/$(database)/documents/salons/$(salonId)).data;
      let deposit = salon.get('deposit', {});
      return deposit.get('enabled', false) == true && (
        (deposit.get('method', 'mercadopago') == 'transfer' && salon.get('paymentAlias', '') != '') ||
        (deposit.get('method', 'mercadopago') != 'transfer' && salon.get('mpConnected', false) == true)
      );
    }

    match /userProfiles/{userProfileId} {
      allow get: if isSignedIn() && request.auth.uid == userProfileId;
      allow list: if isGlobalAdmin();
      allow create, update: if isRealUser() && request.auth.uid == userProfileId;
      allow delete: if isGlobalAdmin();
    }

    match /globalAdmins/{userId} {
      allow get: if isRealUser() && request.auth.uid == userId;
      allow list: if isGlobalAdmin();
      allow write: if false;
    }

    match /salons/{salonId} {
      // Cualquiera puede leer para mostrar la página pública
      allow get: if true;
      allow list: if isGlobalAdmin() || (
        isRealUser() && resource.data.adminMembers[request.auth.uid] == true
      );
      // Los negocios los crea el servidor (registro gratis o super-admin), o un admin global.
      allow create: if isGlobalAdmin();
      // El dueño edita su negocio, pero no su plan, suscripción, estado, dueños ni Mercado Pago.
      allow update: if isGlobalAdmin() || (
        isSalonAdmin(salonId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isActive', 'plan', 'subscriptionExpiresAt', 'subscriptionStatus', 'subscriptionId',
          'trialEndsAt', 'adminMembers', 'createdBy', 'mpConnected', 'mpUserId', 'mpConnectedAt',
          'mpPreapprovalId', 'mpSubscriptionStatus', 'mpPayerEmail', 'mpPendingFirstPayment', 'mpCheckout',
          'evolutionInstanceName', 'email'
        ])
      );
      allow delete: if isGlobalAdmin();

      match /services/{serviceId} {
        allow get, list: if true;
        allow write: if isSalonAdmin(salonId) || isGlobalAdmin();
      }

      match /professionals/{professionalId} {
        allow get, list: if true;
        allow write: if isSalonAdmin(salonId) || isGlobalAdmin();
      }

      // Sucursales: públicas (las usa la página de reservas), las edita el dueño
      match /branches/{branchId} {
        allow get, list: if true;
        allow write: if isSalonAdmin(salonId) || isGlobalAdmin();
      }
    }

    // Reseñas de la página pública del negocio: cualquiera las lee y cualquiera deja
    // una, pero solo con los campos y tamaños esperados. El dueño puede borrarlas.
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if request.resource.data.keys().hasOnly(['salonId', 'customerName', 'comment', 'rating', 'createdAt'])
        && request.resource.data.salonId is string
        && exists(/databases/$(database)/documents/salons/$(request.resource.data.salonId))
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0 && request.resource.data.customerName.size() <= 60
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0 && request.resource.data.comment.size() <= 1000
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isSalonAdmin(resource.data.salonId) || isGlobalAdmin();
    }

    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        isSalonAdmin(resource.data.salonId) ||
        isGlobalAdmin()
      );
      // Los turnos tienen datos de los clientes: solo los listan el negocio, el admin
      // de Turnify o el propio cliente. La página de reservas pide los horarios
      // ocupados al servidor (/api/availability), sin nombres ni teléfonos.
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        isSalonAdmin(resource.data.salonId) ||
        isGlobalAdmin()
      );
      // Si el negocio cobra seña, el cliente solo puede crear el turno "esperando seña"
      // (lo confirma el servidor con Mercado Pago, o el dueño si es por transferencia).
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.get('depositStatus', 'none') != 'paid'
        && (
          (request.resource.data.status == 'confirmed' && (
            !depositRequired(request.resource.data.salonId) ||
            isSalonAdmin(request.resource.data.salonId)
          )) ||
          (request.resource.data.status == 'pending_payment' &&
            request.resource.data.paymentExpiresAt is timestamp &&
            request.resource.data.paymentExpiresAt < request.time + duration.value(1450, 'm'))
        );
      // El cron ahora escribe con acceso de servidor: nadie sin sesión puede tocar turnos.
      allow update: if (isSignedIn() && (
        isSalonAdmin(resource.data.salonId) ||
        isGlobalAdmin()
      )) || (
        // El cliente puede editar su turno, pero no confirmarlo ni tocar la seña
        isSignedIn() && resource.data.customerId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'depositStatus', 'depositAmount', 'depositPaidAmount', 'depositPaymentId',
          'depositNeedsRefund', 'paymentExpiresAt', 'depositMethod', 'transferNotifiedAt',
          'salonId', 'customerId', 'confirmationSentAt', 'cancellationNotifiedAt', 'ownerNotifiedAt'
        ]) &&
        (request.resource.data.status == resource.data.status ||
          request.resource.data.status in ['cancelled', 'completed']) &&
        !(resource.data.status == 'pending_payment' && request.resource.data.status == 'completed')
      );
      allow delete: if isGlobalAdmin();
    }

    // Solo el servidor (credenciales de Mercado Pago, dispositivos, límites, pagos)
    match /mpAccounts/{salonId} {
      allow read, write: if false;
    }
    match /mpOAuthStates/{stateId} {
      allow read, write: if false;
    }
    match /pushTokens/{tokenId} {
      allow read, write: if false;
    }
    match /signupLimits/{id} {
      allow read, write: if false;
    }
    match /subscriptionPayments/{id} {
      allow read, write: if false;
    }
    match /subscriptionAlerts/{id} {
      allow read, write: if false;
    }
    match /payments/{paymentId} {
      allow read, write: if false;
    }
    match /cronRuns/{id} {
      allow read, write: if false;
    }
  }
}
