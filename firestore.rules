rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isRealUser() {
      return isSignedIn() && !isAnonymous();
    }

    function isGlobalAdmin() {
      return isRealUser() && exists(/databases/$(database)/documents/globalAdmins/$(request.auth.uid));
    }

    function isSalonAdmin(salonId) {
      return isRealUser() && (
        get(/databases/$(database)/documents/salons/$(salonId)).data.adminMembers[request.auth.uid] == true
      );
    }

    match /userProfiles/{userProfileId} {
      allow get: if isSignedIn() && request.auth.uid == userProfileId;
      allow list: if isGlobalAdmin();
      allow create, update: if isRealUser() && request.auth.uid == userProfileId;
      allow delete: if isGlobalAdmin();
    }

    match /globalAdmins/{userId} {
      allow get: if isRealUser() && request.auth.uid == userId;
      allow list: if isGlobalAdmin();
      allow write: if false;
    }

    match /salons/{salonId} {
      // Cualquiera puede leer para mostrar la página pública
      allow get: if true;
      // Solo admins globales pueden listar todos
      allow list: if isGlobalAdmin() || (
        isRealUser() && resource.data.adminMembers[request.auth.uid] == true
      );
      // Solo usuarios reales pueden crear su salón
      allow create: if isRealUser();
      // Solo el admin del salón o global admin pueden editar/borrar.
      // El campo isActive (activar/desactivar cuenta) solo lo puede tocar un global admin.
      allow update: if isGlobalAdmin() || (
        isSalonAdmin(salonId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive'])
      );
      allow delete: if isGlobalAdmin();

      match /services/{serviceId} {
        allow get, list: if true;
        allow write: if isSalonAdmin(salonId) || isGlobalAdmin();
      }

      match /professionals/{professionalId} {
        allow get, list: if true;
        allow write: if isSalonAdmin(salonId) || isGlobalAdmin();
      }
    }

    match /appointments/{appointmentId} {
      // Solo usuarios autenticados pueden leer sus propios turnos o los del salón
      allow get: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        isSalonAdmin(resource.data.salonId) ||
        isGlobalAdmin()
      );
      // TODO(seguridad): esto permite a cualquier usuario logueado listar TODOS los
      // turnos de TODOS los salones (nombres, teléfonos). No se puede restringir a
      // "solo mis turnos" o "solo mi salón" sin romper la disponibilidad de horarios
      // del flujo público de reserva (BookingFlow necesita ver los turnos de otros
      // clientes para saber qué horarios están ocupados). Solución correcta: exponer
      // la ocupación de horarios desde una colección/endpoint separado que no incluya
      // datos del cliente, y recién ahí restringir esta regla a dueño/admin del salón.
      allow list: if isSignedIn();
      // Cualquier usuario autenticado puede crear una reserva
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      // Solo el cliente dueño del turno o el admin del salón pueden cancelar.
      // El cron (llamada sin auth, vía API key) solo puede: (a) tocar los flags de
      // recordatorio/reseña, o (b) auto-completar un turno que ya pasó (confirmed ->
      // completed). Nunca puede cancelar un turno ni tocar cualquier otro campo —
      // antes la regla permitía cambiar `status` a cualquier valor sin ningún auth,
      // lo que dejaba cancelar turnos de cualquier salón a cualquiera sin loguearse.
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reminderSent24h', 'reminderSentSameDay', 'reviewSent'])
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        resource.data.status == 'confirmed' &&
        request.resource.data.status == 'completed'
      ) || (isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        isSalonAdmin(resource.data.salonId) ||
        isGlobalAdmin()
      ));
      allow delete: if isGlobalAdmin();
    }

    match /payments/{paymentId} {
      // Colección sin ningún uso en el código actual (no hay lecturas ni escrituras
      // en el repo) pero estaba abierta a lectura/escritura de cualquier usuario
      // logueado, de cualquier documento. La cierro hasta que se implemente con un
      // esquema y reglas propias acorde a los datos que vaya a guardar.
      allow read, write: if false;
    }
  }
}
